<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 设置页不使用 AndroidX 动态广播兼容层，移除其自动合并的内部权限。 -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <!-- LSPosed 模块声明 -->
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_powermenu"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_powermenu"
        android:theme="@style/Theme.BetterPowerMenu">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/settings_title"
            android:launchMode="singleTop"
            android:theme="@style/Theme.BetterPowerMenu">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name=".config.SettingsProvider"
            android:authorities="com.youngsix6.betterpowermenu.settings"
            android:exported="true"
            android:grantUriPermissions="false" />

        <!-- 模块无需 Emoji/生命周期/ProfileInstaller 的进程启动初始化。 -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            tools:node="remove" />
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/xposed_description" />
        <meta-data
            android:name="xposedminversion"
            android:value="53" />
        <!-- 模块作用域：仅注入 SystemUI -->
        <meta-data
            android:name="xposedscope"
            android:value="com.android.systemui" />
    </application>

</manifest>
